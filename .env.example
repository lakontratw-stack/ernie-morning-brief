# LINE Messaging API
LINE_CHANNEL_SECRET=replace_me
LINE_CHANNEL_ACCESS_TOKEN=replace_me
LINE_SENDER_NAME=Lyra

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WORK_GROUP_CHAT_ID=replace_me

# App
APP_DB_PATH=./lyra_line.db
PUBLIC_BASE_URL=https://your-service.onrender.com
TAKEOVER_HOURS=12

# Lyra response engine.
# Options:
# - mock: local deterministic replies for integration testing
# - hermes_cli: call Hermes CLI by subprocess
# - openai_compatible: call any OpenAI-compatible chat completions endpoint
LYRA_PROVIDER=mock

# Keep this disabled unless you verified OpenCC works correctly on the host.
# The app's default replies are already written in Traditional Chinese.
ENABLE_OPENCC=false

# Optional Google Sheet CSV knowledge sources.
# Publish each sheet tab as CSV, then paste the public CSV URLs here.
STORE_HOURS_CSV_URL=
PROMOTIONS_CSV_URL=

# Optional Watsons Taiwan official public store list.
# This provides all store names and addresses. Hours still need Google Sheet
# rows or individual official store pages because the public list has no hours.
WATSONS_STORE_LIST_URL=https://www.watsons.com.tw/storedescription
WATSONS_OPENCHAT_URL=https://www.watsons.com.tw/openchat
WATSONS_STORE_CACHE_PATH=data/watsons_stores.csv
WATSONS_ENABLE_LIVE_FETCH=false
WATSONS_FETCH_TIMEOUT=90
WATSONS_FETCH_RETRIES=2

# Hermes CLI mode
HERMES_BIN=hermes
HERMES_WORKDIR=/Users/ernieliu/Documents/New project 3

# OpenAI-compatible mode
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=replace_me
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini
