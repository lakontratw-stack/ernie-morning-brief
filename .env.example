# LINE Messaging API
LINE_CHANNEL_SECRET=replace_me
LINE_CHANNEL_ACCESS_TOKEN=replace_me
LINE_SENDER_NAME=Lyra

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WORK_GROUP_CHAT_ID=replace_me

# App
APP_DB_PATH=./lyra_line.db
PUBLIC_BASE_URL=https://your-service.onrender.com
TAKEOVER_HOURS=12

# Lyra response engine.
# Options:
# - mock: local deterministic replies for integration testing
# - hermes_cli: call Hermes CLI by subprocess
# - openai_compatible: call any OpenAI-compatible chat completions endpoint
LYRA_PROVIDER=mock

# Hermes CLI mode
HERMES_BIN=hermes
HERMES_WORKDIR=/Users/ernieliu/Documents/New project 3

# OpenAI-compatible mode
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=replace_me
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini
